# Example only. Save as .env when installing for the first time.
# If upgrading, keep your EXISTING .env file unchanged.
CROSSMATCH_HTTP_PORT=18090
CROSSMATCH_HTTPS_PORT=18444
CROSSMATCH_HTTPS_BIND_IP=127.0.0.1
CROSSMATCH_COOKIE_SECURE=0
CACHE_EXPIRATION_HOURS=12
AUTH_SESSION_HOURS=12
MAX_UPLOAD_GB=25
MAX_CONCURRENT_JOBS=1
CROSSMATCH_CPU_WORKERS=0
CROSSMATCH_MEMORY_PERCENT=80

# Required for first-admin creation. START_DOCKER.bat generates it on a new install.
# Alternatively run GENERATE_SETUP_KEY.bat locally before starting the app.
# CROSSMATCH_SETUP_KEY=<64 random hexadecimal characters>
